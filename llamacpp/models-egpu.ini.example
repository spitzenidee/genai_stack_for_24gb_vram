version = 1

; ── Global defaults inherited by every model ──────────────────────────────────
[*]
cache-type-k = q8_0
cache-type-v = q8_0
flash-attn = auto
parallel = 1
context-shift = true
no-mmap = true
timeout = 7200
sleep-idle-seconds = 1800
threads = 4
threads-batch = 7
batch-size = 4096
ubatch-size = 2048
n-gpu-layers = 99
jinja = true
repeat-penalty = 1.05
reasoning = on
reasoning-budget = 8192
reasoning-budget-message = Enough thinking, answering now.
cache-reuse = 512
kv-unified = true
spec-type = ngram-mod
spec-ngram-mod-n-match = 40
spec-ngram-mod-n-min = 4
spec-ngram-mod-n-max = 32
spec-draft-n-max = 2
; seed = 3407                    ; fixed seed for reproducibility

; ── Per-model overrides ────────────────────────────────────────────────────────
; preserve_thinking=false: strip prior thinking from context in multi-turn (reduces loop priming).
; auto_disable_thinking_with_tools=false: allow thinking during tool calls — model reasons
;   before each tool invocation, improving code/spec decisions. Monitor for loops on stuck states;
;   DRY + presence-penalty + reasoning-budget provide the safety net.
[Qwen3.6-27B-MTP-Q4_K_M]
model = /models/Qwen3.6-27B-MTP-Q4_K_M.gguf
c = 131072
cache-type-k = q8_0
cache-type-v = q8_0
flash-attn = true
chat-template-file = /models/qwen36_chat_template.jinja
chat-template-kwargs = {"preserve_thinking": false, "auto_disable_thinking_with_tools": false}
temp = 0.6
top-k = 20
top-p = 0.95
min-p = 0
repeat-penalty = 1.0
dry-multiplier = 1.0
dry-base = 1.75
dry-allowed-length = 2
presence-penalty = 1.1
reasoning-budget = 3072
spec-type = draft-mtp,ngram-mod
spec-draft-n-max = 6
spec-draft-n-min = 1
spec-draft-p-min = 0.4
spec-ngram-mod-n-min = 0
spec-ngram-mod-n-max = 16

; ───────────────────────────────────────────────────────────────────────────────
[Qwen3.6-35B-A3B-MTP-Q4_K_M]
model = /models/Qwen3.6-35B-A3B-MTP-Q4_K_M.gguf
c = 131072
cache-type-k = q8_0
cache-type-v = q8_0
flash-attn = true
chat-template-file = /models/qwen36_chat_template.jinja
chat-template-kwargs = {"preserve_thinking": false, "auto_disable_thinking_with_tools": false}
temp = 0.6
top-k = 20
top-p = 0.95
min-p = 0
repeat-penalty = 1.0
dry-multiplier = 1.0
dry-base = 1.75
dry-allowed-length = 2
reasoning-budget = 3072
presence-penalty = 1.1
spec-type = draft-mtp,ngram-mod
spec-draft-n-max = 6
spec-draft-n-min = 1
spec-draft-p-min = 0.4
spec-ngram-mod-n-min = 0
spec-ngram-mod-n-max = 16

; ───────────────────────────────────────────────────────────────────────────────
[Gemma4-26B-A4B-QAT-Q4_K_M]
model = /models/Gemma4-26B-A4B-QAT-Q4_K_M.gguf
model-draft = /models/mtp-gemma-4-26B-A4B-it.gguf
c = 262144
cache-type-k = q8_0
cache-type-v = q8_0
repeat-penalty = 1.1
spec-type = draft-mtp,ngram-mod
spec-draft-n-max = 2
spec-draft-n-min = 1
spec-draft-p-min = 0.4
temp = 0.6
top-k = 64
top-p = 0.9
min-p = 0.05
; swa-full = true                 ; force full attention on all SWA layers (higher quality, +VRAM)

; ───────────────────────────────────────────────────────────────────────────────
[Gemma4-31B-QAT-Q4_K_M]
model = /models/Gemma4-31B-QAT-Q4_K_M.gguf
model-draft = /models/mtp-gemma-4-31B-it.gguf
c = 100000
cache-type-k = q4_0
cache-type-v = q4_0
temp = 0.6
top-k = 64
top-p = 0.9
min-p = 0.05
repeat-penalty = 1.1
spec-type = draft-mtp,ngram-mod
spec-draft-n-max = 2
spec-draft-n-min = 1
spec-draft-p-min = 0.6
; swa-full = true

; ───────────────────────────────────────────────────────────────────────────────
[VibeThinker-3B.Q8_0]
model = /models/VibeThinker-3B.Q8_0.gguf
c = 131072
n-predict = 100000
reasoning-budget = 98304
temp = 1.0
top-k = 0
top-p = 0.95
