# ─── Sanitized Mirror Config ───────────────────────────────────────────────
# Target GitHub repository — no protocol prefix, no leading slash
TARGET_REPO="github.com/spitzenidee/genai_stack_for_24gb_vram.git"

# The local Gitea branch that is allowed to be mirrored
SOURCE_BRANCH="public"

# The branch name to create/update on GitHub
DEST_BRANCH="dev"

# ─── Sanitation list ───────────────────────────────────────────────────────
# Paths to delete from the runner workspace before pushing (one per line).
# Always keep .gitea/ and mirror_config.env itself in this list.
EXCLUDE_LIST="\
  .gitea/ \
  .gitmodules \
  mirror_config.env \
  um790pro_7900xtx_setup \
  gemini_gitea_mirroring_proposal.md \
  lact/config.yaml \
  llamacpp/models.ini \
  llamacpp/hfmodels \
  comfyui/models \
"
