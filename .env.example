APP_ROOT=/path/to/your/project

OPEN_WEBUI_PORT=8080
LLAMA_CPU_PORT=8090
LLAMA_VULKAN_PORT=8092
GPU_EXPORTER_PORT=9898
LLAMA_SD_PORT=8099
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_GRPC_ENDPOINT=127.0.0.1:4317
COMFYUI_ROCM_PORT=8082

RENDER_GID=1000
VIDEO_GID=1000

GPU_RENDER_DEVICE=/dev/dri/renderD128
GPU_CARD_DEVICE=/dev/dri/card1

WEBUI_SECRET_KEY=replace-with-a-long-random-secret

# Optional tuning knobs
LLAMA_CPU_CPUS=7.0
LLAMA_CPU_THREADS=7
LLAMA_CPU_BATCH_SIZE=4096
LLAMA_CPU_UBATCH_SIZE=4096
LLAMA_CPU_MODELS_MAX=2

LLAMA_VULKAN_MODELS_MAX=1
LLAMA_VULKAN_BATCH_SIZE=2048
LLAMA_VULKAN_UBATCH_SIZE=4096
