APP_ROOT=/path/to/your/project

# Host user/group IDs for services that write into bind-mounted work dirs.
# Defaults to 1000:1000; override if your local user has a different UID/GID.
UID=1000
GID=1000

OPEN_WEBUI_PORT=8080
LLAMA_CPU_PORT=8090
LLAMA_EGPU_PORT=8092
LLAMA_IGPU_PORT=8093
GPU_EXPORTER_PORT=9898
LLAMA_SD_PORT=8099
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
COMFYUI_ROCM_PORT=8082

RENDER_GID=1000
VIDEO_GID=1000

# eGPU (discrete GPU)
GPU_RENDER_DEVICE=/dev/dri/renderD128
GPU_CARD_DEVICE=/dev/dri/card1

# iGPU (if passed through) — identify via /sys/class/drm/*/device/uevent
GPU_IGPU_RENDER_DEVICE=/dev/dri/renderD129
GPU_IGPU_CARD_DEVICE=/dev/dri/card2

# Prometheus HTTP SD target list consumed by llama-sd (otel/llama_sd.py)
LLAMA_SERVERS=[{"url":"http://llamacpp-cpu:8090","name":"cpu"},{"url":"http://llamacpp-egpu:8092","name":"egpu"},{"url":"http://llamacpp-igpu:8093","name":"igpu"}]

# Parent directory holding GROMACS simulation projects (mounted at /work in
# gromacs-rocm). Point this at a common parent of all your MD projects to
# make them all visible without per-project compose edits.
GROMACS_PROJECTS_DIR=${APP_ROOT}/gromacs/work

WEBUI_SECRET_KEY=replace-with-a-long-random-secret

# Optional tuning knobs
LLAMA_CPU_CPUS=7.0
LLAMA_CPU_THREADS=7
LLAMA_CPU_BATCH_SIZE=4096
LLAMA_CPU_UBATCH_SIZE=4096
LLAMA_CPU_MODELS_MAX=2

LLAMA_EGPU_MODELS_MAX=1
LLAMA_EGPU_BATCH_SIZE=2048
LLAMA_EGPU_UBATCH_SIZE=4096

LLAMA_IGPU_MODELS_MAX=1
LLAMA_IGPU_BATCH_SIZE=2048
LLAMA_IGPU_UBATCH_SIZE=4096
