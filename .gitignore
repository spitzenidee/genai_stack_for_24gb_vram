# =============================================================================
# open-webui — entire runtime data directory (DB, cache, uploads, embeddings)
# =============================================================================
open-webui/

# =============================================================================
# llama-cpp — model files (large binaries, managed outside git)
# =============================================================================
hfmodels/
llamacpp/hfmodels/

# =============================================================================
# ComfyUI — runtime data directories (created on first container start)
# =============================================================================
comfyui/models/
comfyui/output/
comfyui/input/
comfyui/custom_nodes/
# patches/ is intentionally tracked (these are source-controlled overrides)

# =============================================================================
# ollama — SSH keys (SECURITY: private key must never be committed)
#          and model blobs (large binaries)
# =============================================================================
ollama/id_ed25519
ollama/id_ed25519.pub
ollama/models/

# =============================================================================
# General work folder
# =============================================================================
work/*

# =============================================================================
# GROMACS — project/work directory (simulation inputs/outputs, generated data);
# smoketest.sh / stresstest.sh are source-controlled and intentionally tracked
# =============================================================================
gromacs/work/*
!gromacs/work/smoketest.sh
!gromacs/work/stresstest.sh

# =============================================================================
# Blender — work directory (scenes, renders, extracted benchmark assets);
# smoketest.sh / stresstest.sh are source-controlled and intentionally tracked
# =============================================================================
# Ignore everything under work, except the two test folders.
blender/work/*
!blender/work/_smoketest/
!blender/work/_stresstest/

# Inside each test folder, keep only the script and downloaded ZIP archives.
blender/work/_smoketest/*
!blender/work/_smoketest/smoketest.sh
!blender/work/_smoketest/*.zip
blender/work/_stresstest/*
!blender/work/_stresstest/stresstest.sh
!blender/work/_stresstest/*.zip

# Ignore extracted benchmark contents recursively (blend files, textures,
# assets, renders and any subdirectories created by unzipping).
blender/work/_smoketest/**/
blender/work/_smoketest/**/*.blend
blender/work/_smoketest/**/*.png
blender/work/_smoketest/**/*.jpg
blender/work/_stresstest/**/
blender/work/_stresstest/**/*.blend
blender/work/_stresstest/**/*.png
blender/work/_stresstest/**/*.jpg

# =============================================================================
# tasks.md — runtime data directories (lanes/tasks + CSS/images/sort state);
# Dockerfile + .dockerignore are source-controlled and intentionally tracked
# =============================================================================
tasks.md/tasks/
tasks.md/config/

# =============================================================================
# orchestrator — runtime artifacts (decision log, slot state, session logs,
# flock); orchestrator.py + README.md are source-controlled
# =============================================================================
orchestrator/.lock
orchestrator/logs/
orchestrator/orchestrator.log
orchestrator/state.json

# =============================================================================
# scripts — benchmark results (generated run output)
# =============================================================================
scripts/bench-results/

# Python bytecode
__pycache__/

# =============================================================================
# Misc
# =============================================================================
# Environment variable files (whitelist .env.example)
.env*
!.env.example
# Background download PID files left by hf_download.sh
_dl
tmp.md

