# vuln-scan config — component-level tunables for scripts/vuln-scan.sh
#
# Precedence: explicit env var > this file > built-in default in the script.
# The values below are the built-in defaults (current behavior); an explicit
# env var (e.g. `VULN_SCAN_TRIVY_IMAGE=... vuln-scan.sh repo .`) overrides
# the corresponding line here.
#
# POSIX sh: plain KEY=value lines only (no set -a, no bash-isms).
#
# Privacy invariants are NOT tunables and stay hardcoded in the script:
# trivy --disable-telemetry --skip-version-check, semgrep --metrics off,
# explicit --config (never --config auto), :ro source mount.

# Pinned scanner images (bump here, not in the script).
VULN_SCAN_TRIVY_IMAGE=aquasec/trivy:0.76.2
VULN_SCAN_SEMGREP_IMAGE=semgrep/semgrep:1.183.0
VULN_SCAN_SHELLCHECK_IMAGE=koalaman/shellcheck-alpine:v0.11.0

# Trivy fs scanners (repo scan) and minimum severity (repo + image scans).
# misconfig = Dockerfile / k8s / terraform misconfiguration checks (no
# docker-compose support upstream — aquasecurity/trivy#8729; compose is
# covered by the in-skill Semgrep ruleset semgrep-compose.yaml instead).
VULN_SCAN_TRIVY_SCANNERS=vuln,secret,misconfig
VULN_SCAN_TRIVY_SEVERITY=MEDIUM,HIGH,CRITICAL

# Semgrep rulesets, comma-separated (expanded to one --config per entry).
# The in-skill docker-compose ruleset (semgrep-compose.yaml) is always added
# on top of these — it is not a registry ruleset.
VULN_SCAN_SEMGREP_RULESETS=p/python,p/javascript,p/typescript,p/java,p/rust,p/dockerfile

# Directory names skipped by both scanners (comma-separated names).
VULN_SCAN_SKIP_DIRS=.git,work,_dl,hfmodels,models,node_modules,__pycache__,.venv,venv,dist,build

# Results root; empty = $STACK_ROOT/work/vuln_scan_results.
VULN_SCAN_RESULTS_DIR=

# Max findings listed in the stdout summary (per report).
VULN_SCAN_SUMMARY_LIMIT=40

# Slopsquatting tier (depsafe + sloppy-joe). Local images are built from
# docker/*.Dockerfile (pinned upstream versions — see docker/depsafe-VERSION
# and the ARG pins in docker/sloppy-joe.Dockerfile) when not present.
VULN_SCAN_DEPSAFE_IMAGE=vuln-scan-depsafe:local
VULN_SCAN_SLOPPYJOE_IMAGE=vuln-scan-sloppy-joe:local

# 0 (default) = offline: depsafe built-in corpus, sloppy-joe fast local
# guardrail (no registry traffic). 1 = online opt-in: depsafe --online
# (PyPI name queries), sloppy-joe --full (registry existence + similarity +
# OSV.dev). Online mode sends only package names — never code.
VULN_SCAN_SLOPSQUAT_ONLINE=0
