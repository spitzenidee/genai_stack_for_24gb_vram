; --- Energy minimization, CG fallback (Phase 4, D10) ---
; Identical to em.mdp except integrator = cg.
; Run ONLY after SD fails to converge (Fmax > emtol), starting from SD's
; final structure (em.gro), never from the initial solvated structure.
integrator  = cg           ; conjugate gradients (faster, riskier on rough structures)
nsteps      = <<<NSTEPS:50000>>>        ; cap; EM usually converges earlier
emtol       = 10           ; max force tolerance, kJ/mol/nm. 1e-4 only for normal-mode analysis.
emstep      = 0.01         ; initial step, nm

; Neighbor / electrostatics (match your cutoffs; see 01.3 box rule)
cutoff-scheme = Verlet
nstlist     = 10
rvdw        = 1.0
rcoulomb    = 1.0
coulombtype = PME
pme-order   = 4
fourierspacing = 0.12

; No temperature/pressure coupling in EM
tcoupl      = no
pcoupl      = no
