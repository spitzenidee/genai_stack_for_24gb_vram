#!/usr/bin/env bash
# pi-igpu-bench — benchmark the iGPU llama instance with Hindsight fully inert.
#
# Why: Hindsight adds a session-start reflect, cron page-refresh workers, and
# session-end write-back — all of which confound iGPU speed measurements. This
# runs pi with Hindsight completely off (no tools, no injection, no persistence),
# pinned to the iGPU model, so tokens/s reflect the GPU alone.
#
# Modeled on scripts/pi-gromacs (same Hindsight-inert mechanism), but with the
# DEFAULT pi system prompt (no persona) for a clean baseline.
#
# Speed signal: the `turn_end` event's `message.durationMs` (pure LLM API-call
# time, excludes pi process startup) divided by `message.usage.output` (output
# tokens). Both are summed across all turns, so agentic multi-turn runs work too.
#
# Usage:
#   pi-igpu-bench                      # interactive: chat, watch the token-speed bar
#   pi-igpu-bench --bench              # non-interactive: built-in prompt, report t/s
#   pi-igpu-bench --bench "PROMPT"     # non-interactive: custom prompt
#   pi-igpu-bench --bench --runs 5     # 5 measured runs (+1 warmup), mean t/s, -> CSV
#
# Options (bench mode):
#   --runs N        measured runs (default 1)
#   --no-warmup     skip the discarded warmup run (default: 1 warmup)
#   --thinking L    thinking level (default high)
#   --model M       model id (default igpu-Qwen3.6-35B-A3B)
#   --csv PATH      result log (default scripts/bench-results/igpu-pi-bench.csv)
#
# Hindsight-inert flags (same as pi-gromacs):
#   HINDSIGHT_DISABLE_HOOKS=1       -> no auto-inject, write-back, seed, idle-retain
#   --exclude-tools 'hindsight_*'   -> removes all 8 hindsight_* tools
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

MODEL="igpu-Qwen3.6-35B-A3B"
THINKING="high"
RUNS=1
WARMUP=1
CSV_LOG="$REPO_ROOT/scripts/bench-results/igpu-pi-bench.csv"
# Fixed prompt: long enough to be bandwidth-bound, deterministic enough to compare.
BENCH_PROMPT_DEFAULT="Explain, in exactly 300 words, how a CPU cache hierarchy works, covering L1/L2/L3, write-back vs write-through, and cache coherence."

export HINDSIGHT_DISABLE_HOOKS=1

# --- parse args ---
MODE="interactive"; PROMPT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --bench)     MODE="bench"; shift ;;
    --runs)      RUNS="$2"; shift 2 ;;
    --no-warmup) WARMUP=0; shift ;;
    --thinking)  THINKING="$2"; shift 2 ;;
    --model)     MODEL="$2"; shift 2 ;;
    --csv)       CSV_LOG="$2"; shift 2 ;;
    -h|--help)   sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)          echo "unknown flag: $1" >&2; exit 2 ;;
    *)           PROMPT="$1"; MODE="bench"; shift ;;
  esac
done

# --- interactive mode: chat and watch the token-speed bar ---
if [[ "$MODE" == "interactive" ]]; then
  exec pi --model "$MODEL" --thinking "$THINKING" --exclude-tools 'hindsight_*'
fi

[[ -n "$PROMPT" ]] || PROMPT="$BENCH_PROMPT_DEFAULT"

# --- bench mode ---
mkdir -p "$(dirname "$CSV_LOG")"
[[ -f "$CSV_LOG" ]] || echo "timestamp,model,thinking,prompt_chars,wall_s,out_tokens,api_ms,ts" > "$CSV_LOG"

# Run one pi session (hindsight inert, ephemeral, JSON). Echo: "wall out_tokens api_ms ts"
run_one() {
  local start end wall out_json
  start=$(date +%s.%N)
  out_json=$(pi --model "$MODEL" --thinking "$THINKING" \
    --exclude-tools 'hindsight_*' --print --no-session --mode json \
    "$PROMPT" 2>/dev/null)
  end=$(date +%s.%N)
  wall=$(awk "BEGIN{printf \"%.2f\", $end-$start}")

  # Sum output tokens + API-call ms across every turn_end event.
  local out_tokens api_ms
  read -r out_tokens api_ms < <(echo "$out_json" | jq -rs '
    [ .[] | select(.type=="turn_end") | .message ]
    | { out: (map(.usage.output // 0) | add),
        ms:  (map(.durationMs   // 0) | add) }
    | "\(.out // 0) \(.ms // 0)"' 2>/dev/null)
  out_tokens=${out_tokens:-0}; api_ms=${api_ms:-0}

  local ts=""
  if (( api_ms > 0 )) && (( out_tokens > 0 )); then
    ts=$(awk "BEGIN{printf \"%.2f\", $out_tokens / ($api_ms/1000)}")
  fi
  echo "$wall $out_tokens $api_ms $ts"
}

# --- warmup (discarded): warms KV cache + MTP draft after a server restart ---
if (( WARMUP > 0 )); then
  echo ">>> warmup (discarded) ..."
  run_one >/dev/null
fi

declare -a rows=() ts_list=()
for run in $(seq 1 "$RUNS"); do
  echo ">>> run $run/$RUNS"
  read -r wall out_tokens api_ms ts < <(run_one)
  echo "    wall=${wall}s  out=${out_tokens} tok  api=${api_ms}ms  => ${ts:-?} t/s"
  rows+=("$(date -Iseconds),$MODEL,$THINKING,${#PROMPT},$wall,$out_tokens,$api_ms,${ts:-}")
  [[ -n "$ts" ]] && ts_list+=("$ts")
done

printf '%s\n' "${rows[@]}" >> "$CSV_LOG"
if (( ${#ts_list[@]} > 0 )); then
  mean=$(printf '%s\n' "${ts_list[@]}" | awk '{s+=$1;n++} END{printf "%.2f", s/n}')
  echo ">>> mean: ${mean} t/s  (${#ts_list[@]} runs)  log: $CSV_LOG"
else
  echo ">>> no valid t/s captured  log: $CSV_LOG"
fi
